# Cloudflare credentials for tools/crawl.mjs, which writes the snapshot the page reads.
# Copy to .env and fill in. .env is gitignored and must stay that way.

# Workers & Pages > Overview, right sidebar
CF_ACCOUNT_ID=

# the SY namespace id, same value as kv_namespaces in worker/wrangler.jsonc
CF_KV_NAMESPACE_ID=4e31fbb9611f46b0b69c66ddf0e50550

# My Profile > API Tokens > Create Token > Custom token.
# One permission is enough: Account > Workers KV Storage > Edit.
# Scope it to this account and nothing else.
CF_API_TOKEN=

# Optional. The defaults assume an ordinary connection, where a full crawl of all
# 203 tickers takes about 150 seconds and nothing is refused.
# PACE_MS=120
# DEADLINE_MS=900000
